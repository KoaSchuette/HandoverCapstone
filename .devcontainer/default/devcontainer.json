{
  "name": "HandoverCapstone (ROS 2 Jazzy)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "ubuntu",
  "runArgs": ["--privileged", //USB Passthrough
              "--network=host", 
              "--ipc=host"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/dev,target=/dev,type=bind" // USB Passthrough
  ],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vscode.cpptools"]
    }
  },
  "postCreateCommand": "sudo apt-get update && rosdep install --from-paths src --ignore-src -y"
}