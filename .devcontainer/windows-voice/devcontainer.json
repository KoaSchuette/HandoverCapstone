{
  "name": "HandoverCapstone (Windows Voice)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "ubuntu",
  "runArgs": [
    "--network=host",
    "--ipc=host"
  ],
  "containerEnv": {
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "PULSE_SERVER": "unix:/mnt/wslg/PulseServer"
  },
  "mounts": [
  "source=\\\\wsl.localhost\\Ubuntu-22.04\\mnt\\wslg,target=/mnt/wslg,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libportaudio2 libasound2-plugins && rosdep install --from-paths src --ignore-src -r -y"