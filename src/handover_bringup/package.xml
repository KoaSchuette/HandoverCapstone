<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handover_bringup</name>
  <version>0.0.0</version>
  <description>Starts the handover cell on mock or real UR5e hardware</description>
  <maintainer email="koa.schuette@queensu.ca">Koa Schuette</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>handover_hand_tracking</exec_depend>
  <exec_depend>handover_motion</exec_depend>
  <exec_depend>handover_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
