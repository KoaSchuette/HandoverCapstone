<?xml version="1.0"?>
<robot name="workcell" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
    
      Frames come from the CAD (see src/handover_cell/README.md):
        world = floor, directly under the robot plate
        +X right, +Y toward the pegboard, +Z up
    -->

    <xacro:include filename="$(find handover_cell)/urdf/handover_cell_macro.xacro"/>
    <xacro:include filename="$(find handover_cell)/urdf/ur5e.xacro"/>

    <!-- Which way the arm faces on the plate. On the real cart the pegboard is on
         the arm's base -X side, and in the CAD frame the pegboard is +Y, so the
         arm is turned -90 deg. This keeps our named poses and planner valid. -->
    <xacro:property name="robot_yaw" value="${-pi/2}"/>

    <!-- Ultraleap position relative to the arm's base_link, sitting on the cart's
         top surface with its front face flush with the front edge.
         From the CAD at the arm's centreline: front edge 0.562 m out from the
         arm, top surface z = 0.7604, arm base (robot_mount) z = 0.7879.
         The sensor is 20 mm deep and 12 mm tall, with its frame origin on its top face:
           leap_x = 0.562 - 0.010             (centre 10 mm in from the edge)
           leap_z = 0.7604 + 0.012 - 0.7879   (bottom face on the table) -->
    <xacro:property name="leap_x" value="0.552"/>
    <xacro:property name="leap_y" value="0.0"/>
    <xacro:property name="leap_z" value="-0.0155"/>

    <material name="sensor_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
    <material name="floor_white">
        <color rgba="1.0 1.0 1.0 0.5"/>
    </material>

    <link name="world"/>

    <!-- Floor, so MoveIt keeps the arm from reaching into the ground -->
    <link name="ground_plane">
        <visual>
            <geometry><box size="3 3 0.01"/></geometry>
            <material name="floor_white"/>
        </visual>
        <collision>
            <geometry><box size="3 3 0.01"/></geometry>
        </collision>
    </link>
    <joint name="world_to_ground_plane" type="fixed">
        <parent link="world"/>
        <child link="ground_plane"/>
        <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </joint>

    <!-- Cart, pegboard frame and pegboard from CAD, plus the robot_mount and
         pegboard_face reference frames -->
    <xacro:handover_cell parent="world"/>

    <!-- Arm + gripper + held tool, bolted to the top of the robot plate -->
    <xacro:ur5e_with_gripper parent="robot_mount" base_z="0" yaw="${robot_yaw}"/>

    <!-- Ultraleap hand tracker -->
    <link name="leap_link">
        <visual>
            <origin xyz="0 -0.006 0" rpy="0 0 0"/>
            <geometry><box size="0.084 0.012 0.020"/></geometry>
            <material name="sensor_black"/>
        </visual>
        <collision>
            <origin xyz="0 -0.006 0" rpy="0 0 0"/>
            <geometry><box size="0.084 0.012 0.020"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.006 0" rpy="0 0 0"/>
            <mass value="0.029"/>
            <inertia ixx="1.3e-6" iyy="1.8e-5" izz="1.7e-5" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <!-- Attached to base_link so it keeps the same pose relative to the arm as in
         the old sim, whatever robot_yaw is. Same rpy as the old sim too. -->
    <joint name="base_link_to_ultraleap" type="fixed">
        <parent link="base_link"/>
        <child link="leap_link"/>
        <origin xyz="${leap_x} ${leap_y} ${leap_z}" rpy="${pi/2} 0 ${pi/2}"/>
    </joint>

</robot>
