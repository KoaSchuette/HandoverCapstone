<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

    <material name="gripper_light_blue">
        <color rgba="0.55 0.75 0.95 1.0"/>
    </material>
    <material name="tool_orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
    </material> 
    <material name="tool_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <!-- UR5e arm with a simple cylindrical gripper and a TCP frame at the gripper tip -->
    <xacro:macro name="ur5e_with_gripper" params="
        parent
        base_z
        name:=ur
        tf_prefix:=''
        gripper_radius:=0.040
        gripper_length:=0.05
        gripper_mass:=0.5">

        <xacro:ur_robot
            name="${name}"
            tf_prefix="${tf_prefix}"
            parent="${parent}"
            joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
            kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
            physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
            visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
            force_abs_paths="true">
            <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
        </xacro:ur_robot>

        <link name="${tf_prefix}gripper">
            <visual>
                <origin xyz="0 0 ${gripper_length / 2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${gripper_radius}" length="${gripper_length}"/>
                </geometry>
                <material name="gripper_light_blue"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${gripper_length / 2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${gripper_radius}" length="${gripper_length}"/>
                </geometry>
            </collision>
            <!-- Solid cylinder about its center of mass -->
            <inertial>
                <origin xyz="0 0 ${gripper_length / 2}" rpy="0 0 0"/>
                <mass value="${gripper_mass}"/>
                <inertia
                    ixx="${gripper_mass * (3 * gripper_radius**2 + gripper_length**2) / 12}"
                    iyy="${gripper_mass * (3 * gripper_radius**2 + gripper_length**2) / 12}"
                    izz="${gripper_mass * gripper_radius**2 / 2}"
                    ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>

        <joint name="${tf_prefix}tool0_to_gripper" type="fixed">
            <parent link="${tf_prefix}tool0"/>
            <child link="${tf_prefix}gripper"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="${tf_prefix}tcp"/>

        <link name="${tf_prefix}held_tool">
            <visual>
                <origin xyz="0 0 0.05" rpy="0 0 0"/>
                <geometry><cylinder radius="0.015" length="0.10"/></geometry>
                <material name="tool_orange"/>
            </visual>
            <collision>
                <origin xyz="0 0 0.05" rpy="0 0 0"/>
                <geometry><cylinder radius="0.015" length="0.10"/></geometry>
            </collision>

            <visual>
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry><cylinder radius="0.005" length="0.10"/></geometry>
                <material name="tool_grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 -0.05" rpy="0 0 0"/>
                <geometry><cylinder radius="0.005" length="0.10"/></geometry>
            </collision>

            <inertial>
                <mass value="0.15"/>
                <inertia ixx="0.000504" iyy="0.000504" izz="0.0000075"
                        ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>
        <joint name="${tf_prefix}gripper_to_tcp" type="fixed">
            <parent link="${tf_prefix}gripper"/>
            <child link="${tf_prefix}tcp"/>
            <origin xyz="0 0 ${gripper_length}" rpy="0 0 0"/>
        </joint>

        <joint name="${tf_prefix}tcp_to_held_tool" type="fixed">
            <parent link="${tf_prefix}tcp"/>
            <child link="${tf_prefix}held_tool"/>
            <origin xyz="0 -0.05 0.005" rpy="1.5708 0 0"/>
        </joint>

    </xacro:macro>

</robot>
